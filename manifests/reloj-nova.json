{
  "schema_version": "1.0",
  "id": "reloj-nova",
  "name": "Reloj Nova",
  "version": "0.1.0",
  "kind": "application",
  "lifecycle": "in-development",
  "repository": {
    "url": "https://github.com/Cumba35/Nova-Workspace",
    "default_branch": "main"
  },
  "capabilities": [
    "clock.alarms",
    "clock.timer",
    "clock.offline"
  ],
  "permissions": [
    {
      "resource": "alarms",
      "action": "create",
      "scope": "self",
      "approval": false
    },
    {
      "resource": "alarms",
      "action": "update",
      "scope": "self",
      "approval": false
    }
  ],
  "data_access": [
    "user-private"
  ],
  "network_policy": "offline-only",
  "offline_support": true,
  "dependencies": []
}
