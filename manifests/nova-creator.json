{
  "schema_version": "1.0",
  "id": "nova-creator",
  "name": "NOVA Creator",
  "version": "0.1.0",
  "kind": "application",
  "lifecycle": "in-development",
  "repository": {
    "url": "https://github.com/Cumba35/Nova-Workspace",
    "default_branch": "main"
  },
  "capabilities": [
    "creator.projects",
    "creator.java",
    "creator.offline"
  ],
  "permissions": [
    {
      "resource": "projects",
      "action": "create",
      "scope": "self",
      "approval": false
    },
    {
      "resource": "source",
      "action": "export",
      "scope": "self",
      "approval": true
    }
  ],
  "data_access": [
    "user-private"
  ],
  "network_policy": "offline-only",
  "offline_support": true,
  "dependencies": []
}
