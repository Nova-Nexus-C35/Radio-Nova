{
  "schema_version": "1.0",
  "id": "calculador-nova",
  "name": "Calculadora Nova",
  "version": "0.1.0",
  "kind": "application",
  "lifecycle": "in-development",
  "repository": {
    "url": "https://github.com/Cumba35/Nova-Workspace",
    "default_branch": "main"
  },
  "capabilities": [
    "calculator.scientific",
    "calculator.graphs",
    "history.local"
  ],
  "permissions": [
    {
      "resource": "history",
      "action": "read",
      "scope": "self",
      "approval": false
    },
    {
      "resource": "history",
      "action": "export",
      "scope": "self",
      "approval": true
    }
  ],
  "data_access": [
    "user-private"
  ],
  "network_policy": "offline-only",
  "offline_support": true,
  "dependencies": []
}
